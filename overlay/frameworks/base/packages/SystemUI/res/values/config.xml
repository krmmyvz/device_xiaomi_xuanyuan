<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- xuanyuan panel supports hardware doze states for AOD. -->
    <bool name="doze_display_state_supported">true</bool>
    <!-- DOZE_SUSPEND must stay off: SystemUI maps DOZE_AOD to it, and in that state HWC stops
         composing, so the AOD clock and the notification icons never update after locking. -->
    <bool name="doze_suspend_display_state_supported">false</bool>
</resources>
