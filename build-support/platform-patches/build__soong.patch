 func squashVendorSrcs(m *Module) {
+	if prebuilt, ok := m.compiler.(*prebuiltLibraryLinker); ok {
+		// Like source libraries, allow vendor-only inputs on a prebuilt that
+		// leaves its core variant to the source provider.
+		prebuilt.prebuiltLinker.properties.Srcs.AppendSimpleValue(
+			prebuilt.baseCompiler.Properties.Target.Vendor.Srcs)
+	}
 	if lib, ok := m.compiler.(*libraryDecorator); ok {
 		lib.baseCompiler.Properties.Srcs.AppendSimpleValue(lib.baseCompiler.Properties.Target.Vendor.Srcs)
 		lib.baseCompiler.Properties.Exclude_srcs.AppendSimpleValue(lib.baseCompiler.Properties.Target.Vendor.Exclude_srcs)
diff --git a/cc/prebuilt_test.go b/cc/prebuilt_test.go
index cade677ee..ef1ad9a9c 100644
--- a/cc/prebuilt_test.go
+++ b/cc/prebuilt_test.go
@@ -603,3 +603,26 @@ func TestMissingVariantInModuleSdk(t *testing.T) {
 	android.AssertBoolEquals(t, fmt.Sprintf("expected dependency from libfoo to source libbar"), true,
 		android.HasDirectDep(ctx, libfoo, sourceLibBar))
 }
+
+func TestPrebuiltVendorOnlySrcsPreserveCore(t *testing.T) {
+	const bp = `
+cc_library_shared {
+    name: "libvendor_image_prebuilt",
+    vendor_available: true,
+}
+cc_prebuilt_library_shared {
+    name: "libvendor_image_prebuilt",
+    vendor_available: true,
+    prefer: true,
+    target: { vendor: { srcs: ["stock.so"], }, },
+}
+`
+	ctx := testPrebuilt(t, bp, android.MockFS{"stock.so": nil}, android.PrepareForTestWithNamespace)
+	vendor := ctx.ModuleForTests(t, "libvendor_image_prebuilt", "android_vendor_arm64_armv8-a_shared").Module().(*Module)
+	core := ctx.ModuleForTests(t, "libvendor_image_prebuilt", "android_arm64_armv8-a_shared").Module().(*Module)
+	stock := ctx.ModuleForTests(t, "prebuilt_libvendor_image_prebuilt", "android_vendor_arm64_armv8-a_shared").Module().(*Module)
+	android.AssertBoolEquals(t, "vendor uses the preferred prebuilt", false, android.IsModulePreferred(vendor))
+	android.AssertBoolEquals(t, "core stays source built", true, android.IsModulePreferred(core))
+	android.AssertBoolEquals(t, "stock vendor input selected", true, stock.Prebuilt().UsePrebuilt())
+	android.AssertStringEquals(t, "vendor Make name remains distinct", ".vendor", stock.SubName())
+}
