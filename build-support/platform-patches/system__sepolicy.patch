+//      http://www.apache.org/licenses/LICENSE-2.0
+//
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package selinux
+
+import (
+	"github.com/google/blueprint/proptools"
+
+	"android/soong/android"
+)
+
+func init() {
+	android.RegisterModuleType("se_prebuilt", sePrebuiltFactory)
+}
+
+type sePrebuiltProperties struct {
+	// Prebuilt policy or contexts file installed as-is into etc/selinux.
+	Src *string `android:"path"`
+
+	// Name of the installed file. Default is {module_name}.
+	Stem *string
+}
+
+// se_prebuilt installs an already-compiled policy file (e.g. a device's stock
+// vendor_sepolicy.cil or vendor_file_contexts) in place of the one the build
+// would generate. Like the other selinux modules it is arch-common, so it can
+// be referenced from them.
+type sePrebuilt struct {
+	android.ModuleBase
+
+	properties    sePrebuiltProperties
+	installSource android.Path
+	installPath   android.InstallPath
+}
+
+func sePrebuiltFactory() android.Module {
+	m := &sePrebuilt{}
+	m.AddProperties(&m.properties)
+	android.InitAndroidArchModule(m, android.DeviceSupported, android.MultilibCommon)
+	return m
+}
+
+func (m *sePrebuilt) stem() string {
+	return proptools.StringDefault(m.properties.Stem, m.Name())
+}
+
+func (m *sePrebuilt) GenerateAndroidBuildActions(ctx android.ModuleContext) {
+	if proptools.String(m.properties.Src) == "" {
+		ctx.PropertyErrorf("src", "must be specified")
+		return
+	}
+	m.installSource = android.PathForModuleSrc(ctx, *m.properties.Src)
+	m.installPath = android.PathForModuleInstall(ctx, "etc", "selinux")
+	ctx.InstallFile(m.installPath, m.stem(), m.installSource)
+	ctx.SetOutputFiles(android.Paths{m.installSource}, "")
+}
+
+func (m *sePrebuilt) AndroidMkEntries() []android.AndroidMkEntries {
+	return []android.AndroidMkEntries{android.AndroidMkEntries{
+		OutputFile: android.OptionalPathForPath(m.installSource),
+		Class:      "ETC",
+		ExtraEntries: []android.AndroidMkExtraEntriesFunc{
+			func(ctx android.AndroidMkExtraEntriesContext, entries *android.AndroidMkEntries) {
+				entries.SetPath("LOCAL_MODULE_PATH", m.installPath)
+				entries.SetString("LOCAL_INSTALLED_MODULE_STEM", m.stem())
+			},
+		},
+	}}
+}
