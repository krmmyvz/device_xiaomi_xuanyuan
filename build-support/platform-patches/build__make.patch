diff --git a/tools/releasetools/common.py b/tools/releasetools/common.py
index 47ab9e7..621a2c9 100644
--- a/tools/releasetools/common.py
+++ b/tools/releasetools/common.py
@@ -1105,8 +1105,11 @@ class PartitionBuildProps(object):
     """
     data = ''
     partition_map = PartitionMapFromTargetFiles(input_file)
-    for prop_file in ['{}/etc/build.prop'.format(partition_map[name]),
-                      '{}/build.prop'.format(partition_map[name])]:
+    # Prebuilt partition images (e.g. BOARD_PREBUILT_VENDOR_DLKMIMAGE) have no
+    # extracted directory in target files; fall back to the conventional name.
+    subdir = partition_map.get(name, name.upper())
+    for prop_file in ['{}/etc/build.prop'.format(subdir),
+                      '{}/build.prop'.format(subdir)]:
       try:
         data = ReadFromInputFile(input_file, prop_file)
         break
@@ -1378,10 +1381,18 @@ def PartitionMapFromTargetFiles(target_files_dir):
       "odm_dlkm": ["ODM_DLKM", "VENDOR/odm_dlkm", "SYSTEM/vendor/odm_dlkm"],
       "system_dlkm": ["SYSTEM_DLKM", "SYSTEM/system_dlkm"],
   }
+  # Signing passes an open target files zip instead of an extracted directory.
+  if isinstance(target_files_dir, zipfile.ZipFile):
+    names = target_files_dir.namelist()
+    def exists(subdir):
+      return any(n.startswith(subdir + "/") for n in names)
+  else:
+    def exists(subdir):
+      return os.path.exists(os.path.join(target_files_dir, subdir))
   partition_map = {}
   for partition, subdirs in possible_subdirs.items():
     for subdir in subdirs:
-      if os.path.exists(os.path.join(target_files_dir, subdir)):
+      if exists(subdir):
         partition_map[partition] = subdir
         break
   return partition_map
diff --git a/tools/releasetools/sign_target_files_apks.py b/tools/releasetools/sign_target_files_apks.py
index 73c4b50..def53e0 100755
--- a/tools/releasetools/sign_target_files_apks.py
+++ b/tools/releasetools/sign_target_files_apks.py
@@ -739,8 +739,17 @@ def ProcessTargetFiles(input_tf_zip: zipfile.ZipFile, output_tf_zip: zipfile.Zip
 
   RegenerateKernelPartitions(input_tf_zip, output_tf_zip, misc_info)
 
+  # A prebuilt vendor_boot (BOARD_PREBUILT_VENDOR_BOOTIMAGE) has no ramdisk tree
+  # to rebuild from, so keep the image; its footer is already signed at build time.
+  keep_vendor_boot = not any(
+      n.startswith("VENDOR_BOOT/RAMDISK/") for n in input_tf_zip.namelist())
+
   for info in input_tf_zip.infolist():
     filename = info.filename
+    if filename == "IMAGES/vendor_boot.img" and keep_vendor_boot:
+      common.ZipWriteStr(output_tf_zip, copy.copy(info),
+                         input_tf_zip.read(filename))
+      continue
     if filename.startswith("IMAGES/"):
       continue
 
