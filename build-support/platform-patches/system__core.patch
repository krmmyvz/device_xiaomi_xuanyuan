+TEST(SchedPolicy, get_cpuset_policy) {
+    if (!cpusets_enabled()) {
+        GTEST_LOG_(INFO) << "skipping test that requires CONFIG_CPUSETS";
+        return;
+    }
+
+    SchedPolicy current_policy = SP_DEFAULT;
+
+    ASSERT_EQ(0, set_cpuset_policy(0, SP_BACKGROUND));
+    ASSERT_EQ(0, get_cpuset_policy(0, &current_policy));
+    EXPECT_EQ(SP_BACKGROUND, current_policy);
+
+    ASSERT_EQ(0, set_cpuset_policy(0, SP_FOREGROUND));
+    ASSERT_EQ(0, get_cpuset_policy(0, &current_policy));
+    EXPECT_EQ(SP_FOREGROUND, current_policy);
+}
