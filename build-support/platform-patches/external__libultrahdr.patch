+// Compatibility ABI for camera blobs built against the Android 15 API, whose
+// size arguments were int rather than size_t.
+std::shared_ptr<DataStruct> generateMpf(int primary_image_size, int primary_image_offset,
+                                        int secondary_image_size, int secondary_image_offset) {
+  return generateMpf(static_cast<size_t>(primary_image_size),
+                     static_cast<size_t>(primary_image_offset),
+                     static_cast<size_t>(secondary_image_size),
+                     static_cast<size_t>(secondary_image_offset));
+}
+
 }  // namespace ultrahdr
