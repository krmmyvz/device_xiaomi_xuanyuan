+bool hasMediaSpeakerVolumeCurve(
+        const media::audio::common::AudioHalEngineConfig& config) {
+    using media::audio::common::AudioHalVolumeCurve;
+    using media::audio::common::AudioStreamType;
+    using media::audio::common::AudioUsage;
+
+    std::set<std::string> mediaVolumeGroupNames;
+    for (const auto& strategy : config.productStrategies) {
+        for (const auto& attributesGroup : strategy.attributesGroups) {
+            const bool isMediaStream =
+                    attributesGroup.streamType == AudioStreamType::MUSIC;
+            const bool hasMediaAttributes = std::any_of(
+                    attributesGroup.attributes.begin(), attributesGroup.attributes.end(),
+                    [](const auto& attributes) {
+                        return attributes.usage == AudioUsage::MEDIA ||
+                                attributes.usage == AudioUsage::GAME ||
+                                attributes.usage ==
+                                        AudioUsage::ASSISTANCE_NAVIGATION_GUIDANCE;
+                    });
+            if ((isMediaStream || hasMediaAttributes) &&
+                    !attributesGroup.volumeGroupName.empty()) {
+                mediaVolumeGroupNames.insert(attributesGroup.volumeGroupName);
+            }
+        }
+    }
+    if (mediaVolumeGroupNames.empty()) {
+        return false;
+    }
+
+    return std::any_of(config.volumeGroups.begin(), config.volumeGroups.end(),
+            [&mediaVolumeGroupNames](const auto& volumeGroup) {
+                if (mediaVolumeGroupNames.count(volumeGroup.name) == 0) {
+                    return false;
+                }
+                return std::any_of(volumeGroup.volumeCurves.begin(),
+                        volumeGroup.volumeCurves.end(), [](const auto& curve) {
+                            return curve.deviceCategory ==
+                                            AudioHalVolumeCurve::DeviceCategory::SPEAKER &&
+                                    !curve.curvePoints.empty();
+                        });
+            });
+}
+
